{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/tasks/rss-import?feed=0&limit=3",
      "schedule": "7 * * * *"
    },
    {
      "path": "/tasks/rss-import?feed=1&limit=3",
      "schedule": "17 * * * *"
    },
    {
      "path": "/tasks/public-money-import/ppa-awards",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/tasks/public-money-import/ppa-contracts",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/tasks/public-money-import/ppa-implementation",
      "schedule": "25 3 * * *"
    },
    {
      "path": "/tasks/public-money-import/mof-budget-2026",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/tasks/public-money-import/mof-finance-2025",
      "schedule": "35 3 * * *"
    },
    {
      "path": "/tasks/government-tenders-import?pages=3&details=18",
      "schedule": "17 */3 * * *"
    },
    {
      "path": "/tasks/financial-status-import",
      "schedule": "43 2 * * *"
    },
    {
      "path": "/tasks/public-cache-warm",
      "schedule": "*/5 * * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/blob-upload",
      "dest": "/api/blob-upload"
    },
    {
      "src": "/build/(.*)",
      "dest": "/build/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/(favicon\\.ico|logo-fav\\.png|website-logo\\.png|robots\\.txt)",
      "dest": "/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/vendor/(.*)",
      "dest": "/vendor/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
